# --- Server ---
PORT=3001
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173   # origins allowed to call the API from another address, e.g. https://<user>.github.io
# Set to 1 when running behind nginx / Render / Fly / Railway etc. so rate limiting sees real client IPs
TRUST_PROXY=0
# Public URL of THIS api (used in confirm / unsubscribe links in emails)
PUBLIC_API_URL=http://localhost:3001
# Public URL of the website (where confirm/unsubscribe pages send people afterwards)
SITE_URL=http://localhost:5173
# Optional: serve the built frontend (vite `dist` folder) from this same server
# FRONTEND_DIST=web/dist   # default; only set this to serve the site from somewhere else

# --- Storage ---
DATABASE_PATH=./data/nulglow.db

# --- Admin (REQUIRED to use /api/admin/*). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Reviews ---
# true  = reviews appear immediately (matches current frontend behaviour)
# false = reviews wait in "pending" until approved via the admin API
REVIEWS_AUTO_APPROVE=true

# --- Email (optional; without SMTP_HOST emails are printed to the console) ---
CONTACT_INBOX=clara.kolosoan@gmail.com
MAIL_FROM="NULGlow <no-reply@nulglow.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
